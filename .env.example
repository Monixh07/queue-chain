# Copy this file to backend/.env and replace the placeholders.
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_local_mysql_password
DB_NAME=queuechain

# Generate random values with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_random_secret_at_least_32_characters
ADMIN_SETUP_KEY=replace_with_a_different_random_secret

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
QUEUECHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
